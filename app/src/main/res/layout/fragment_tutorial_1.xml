<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp">

    <ImageView
        android:id="@+id/iv_tutorial_1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@android:drawable/ic_menu_agenda"
        android:contentDescription="@string/tut_tasks_title"
        app:tint="@color/primary_dark"
        android:layout_marginBottom="32dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_tut_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_tut_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tut_tasks_title"
        android:textSize="28sp"
        android:textColor="@color/primary_dark"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_tutorial_1"
        app:layout_constraintBottom_toTopOf="@+id/tv_tut_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_tut_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tut_tasks_desc"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tut_title"
        app:layout_constraintBottom_toTopOf="@+id/btn_next_tut"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_next_tut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="250dp"
        android:minHeight="48dp"
        app:cornerRadius="50dp"
        android:text="@string/btn_next"
        android:textColor="@color/card_background"
        android:backgroundTint="@color/primary_dark"
        app:layout_constraintTop_toBottomOf="@+id/tv_tut_desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>