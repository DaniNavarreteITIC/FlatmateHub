<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_pref_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preferences_title"
            android:textAllCaps="true"
            android:textSize="22sp"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_prefs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/pref_save"
            android:textColor="@color/primary_dark"
            app:layout_constraintTop_toTopOf="@id/tv_pref_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_pref_title"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tv_section_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/pref_section_profile"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_pref_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/btn_edit_name_email"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/pref_name_email"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:drawableEndCompat="@android:drawable/ic_arrow_forward"
            app:drawableTint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_section_profile" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/div1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/btn_edit_name_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tv_section_flat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pref_section_flat"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/div1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/btn_edit_flat_name"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/pref_flat_name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:drawableEndCompat="@android:drawable/ic_arrow_forward"
            app:drawableTint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_section_flat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/btn_edit_flat_users"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/pref_flat_users"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:drawableEndCompat="@android:drawable/ic_arrow_forward"
            app:drawableTint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/btn_edit_flat_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/btn_view_flat_code"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/pref_flat_code"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:drawableEndCompat="@android:drawable/ic_menu_share"
            app:drawableTint="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/btn_edit_flat_users"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/div2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/btn_view_flat_code"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tv_section_notif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pref_section_notif"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/div2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_notif_tasks"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/pref_notif_tasks"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:checked="true"
            app:layout_constraintTop_toBottomOf="@id/tv_section_notif"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_notif_expenses"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/pref_notif_expenses"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:checked="true"
            app:layout_constraintTop_toBottomOf="@id/switch_notif_tasks"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/div3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/switch_notif_expenses"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_dark_mode"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/pref_dark_mode"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/div3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>