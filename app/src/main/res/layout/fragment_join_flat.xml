<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp">
        <TextView
            android:id="@+id/tv_join_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/join_flat_title"
            android:textSize="26sp"
            android:textColor="@color/secondary"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_join_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_join_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/join_flat_desc"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tv_join_title"
            app:layout_constraintBottom_toTopOf="@+id/til_flat_code"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="3dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_flat_code"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/flat_code_hint"
            app:layout_constraintTop_toBottomOf="@+id/tv_join_desc"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm_join"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_flat_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="6"
                android:inputType="text"
                android:autofillHints="postalCode"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_join"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="56dp"
            app:backgroundTint="@color/secondary_dark"
            android:text="@string/btn_join_flat"
            app:layout_constraintTop_toBottomOf="@id/til_flat_code"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="6dp"
            android:stateListAnimator="@null">
        </com.google.android.material.button.MaterialButton>
</androidx.constraintlayout.widget.ConstraintLayout>