<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/primary"
        android:padding="24dp"
        android:gravity="top"
        tools:ignore="MissingConstraints">
     <ImageView
        android:id="@+id/btn_open_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cont_des_preference"
        app:tint="@android:color/widget_edittext_dark"/>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_flatmate"
        android:contentDescription="@string/logo_desc"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/card_background"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="22dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/preferences_title"
        android:backgroundTint="@color/primary_dark"
        android:layout_marginBottom="22dp"
        android:elevation="6dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btn_menu_change_flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/pref_change_flat"
        android:backgroundTint="@color/primary_dark"
        android:layout_marginBottom="22dp"
        android:elevation="6dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btn_menu_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/logout"
        android:textColor="@color/card_background"
        android:backgroundTint="@android:color/holo_red_dark"
        android:elevation="6dp"
        android:stateListAnimator="@null"/>

</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>